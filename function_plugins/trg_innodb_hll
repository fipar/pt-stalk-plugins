# Prints Innodb's history list length
# Usage: --function trg_innodb_hll --threshold 1000 (will trigger a capture if history list length is greater than 1000)

function trg_plugin()
{
res=$(mysql $EXT_ARGV -Bne "select count from information_schema.innodb_metrics where name = 'trx_rseg_history_len'")
[ -n "$res" ] && echo $res || echo 0
}
